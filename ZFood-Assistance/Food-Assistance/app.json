{
  "expo": {
    "name": "ZFood assistance",
    "slug": "zfoodassistance",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zfoodassistance",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "EXPO_PUBLIC_DOMAIN": "zfood-assistance.vercel.app",
      "eas": {
        "projectId": "3acd4ce3-f84f-4b69-8195-a8ffc4e75df3"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zfoodassistance.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16a34a",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.zfoodassistance.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16a34a",
          "dark": {
            "backgroundColor": "#14532d"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
