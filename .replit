modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"
packages = ["unzip", "firebase-tools"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Webapp Dev Server"

[[workflows.workflow]]
name = "Webapp Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd ZFood-Assistance/Food-Assistance/webapp && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
